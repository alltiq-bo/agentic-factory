# ── GitHub ────────────────────────────────────────────────────────────────
# Personal Access Token — scopes requeridos: repo + project
GH_TOKEN=ghp_...

# ── Orchestrator ──────────────────────────────────────────────────────────
TEAM_CONFIG=dotnet-react-migration
LOG_LEVEL=INFO

# ── Claude Code CLI (provider: claude_code — sin API key) ─────────────────
# Path al binario claude (omitir si está en PATH)
CLAUDE_BIN=/root/.npm-global/bin/claude
# Sesión a usar: ~/.claude-personal | ~/.claude-work | ~/.claude
CLAUDE_CONFIG_DIR=~/.claude-personal
# Directorios del proyecto accesibles por los agentes (separados por :)
CLAUDE_ADD_DIRS=/home/apps/web/react/web.agro.nt
# Timeout en segundos por llamada al CLI (default: 600)
CLAUDE_TIMEOUT=600

# ── LLM Providers alternativos (completar solo el que se usa) ─────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Proyecto externo (opcional) ───────────────────────────────────────────
# Si se define, ConfigLoader busca team/workflow/profiles en <dir>/.agentiq/
# AGENTIC_PROJECT_DIR=/home/apps/web/react/web.agro.nt
