# ── LLM Providers (set only what you use) ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# ── Infrastructure ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
POSTGRES_URL=postgresql://agentuser:agentpass@postgres:5432/agentdb

# ── Ollama (only needed for local LLM profile) ────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434

# ── Orchestrator ──────────────────────────────────────────────────────────
TEAM_CONFIG=dotnet-react-migration
LOG_LEVEL=INFO
